# Salin menjadi .env. Jangan commit .env. Agent Claude Code dilarang membacanya (.claude/settings.json).

# ---- Penyimpanan online (Supabase project Adyaspace) ----
SUPABASE_URL=https://gvikzfnxxgcbaoapeipq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # kosong = simpan sebagai file lokal di data/
SESSION_SECRET=              # string acak panjang; wajib online
CRON_SECRET=                 # string acak; Vercel mengirimnya ke /api/cron

# ---- Dashboard Meja Keputusan ----
DASHBOARD_PIN=            # wajib untuk masuk dashboard; online minimal 10 karakter
DASHBOARD_HOST=127.0.0.1  # jangan 0.0.0.0 tanpa reverse proxy + login
DASHBOARD_PORT=4747

# ---- Pengaman ----
AUTOPILOT=                # 1 = aksi risiko rendah sesuai aturan/kebijakan.json langsung disetujui. Nyalakan setelah 2 minggu memantau draf.
KARYAWAN_LIVE=            # 1 hanya di cron VPS: izinkan bin/kirim.mjs --live
WA_MAX_PER_DAY=200

# ---- Claude API (CS WhatsApp) ----
ANTHROPIC_API_KEY=
# CS_MODEL=claude-haiku-5-5
CS_AUTODRAFT=1            # webhook memicu cs-draft 20 detik setelah pesan terakhir masuk

# ---- WhatsApp Cloud API (Meta) ----
META_GRAPH_VERSION=v26.0
WA_VERIFY_TOKEN=          # string acak buatan Anda, sama dengan yang diisi di Meta App Dashboard
WA_APP_SECRET=            # App Secret aplikasi Meta, untuk memverifikasi tanda tangan webhook
WA_PHONE_ID_ADYASPACE=
WA_TOKEN_ADYASPACE=       # System User token permanen, bukan token sementara 24 jam
WA_PHONE_ID_PIRAMID_FORKLIFT=
WA_TOKEN_PIRAMID_FORKLIFT=

# ---- Konten (Threads, Instagram, Facebook) ----
MAX_POSTS_PER_DAY=3
FB_PAGE_ID_PIRAMID_FORKLIFT=
FB_PAGE_TOKEN_PIRAMID_FORKLIFT=
IG_USER_ID_PIRAMID_FORKLIFT=
IG_TOKEN_PIRAMID_FORKLIFT=
THREADS_USER_ID_PIRAMID_FORKLIFT=
THREADS_TOKEN_PIRAMID_FORKLIFT=
FB_PAGE_ID_ADYASPACE=
FB_PAGE_TOKEN_ADYASPACE=
IG_USER_ID_ADYASPACE=
IG_TOKEN_ADYASPACE=
THREADS_USER_ID_ADYASPACE=
THREADS_TOKEN_ADYASPACE=
